{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Flask (Zikrnoor)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        },
        {
            "name": "Open in Chrome (Flask running)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5000/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open in Chrome (Live Server)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}